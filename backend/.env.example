# AgriGuard AI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://agriguard-ai.vercel.app

# Database Configuration (SQLite default; PostgreSQL supported for production)
DATABASE_URL=sqlite:///./agri_guard.db

# Model Configuration
MODEL_PATH=./ml_weights/mobilenetv2_plantvillage.pth
CONFIDENCE_THRESHOLD=0.60
DEMO_MODE=false

# Upload Storage (Images stored only if retention enabled by user)
ENABLE_IMAGE_STORAGE=true
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10
